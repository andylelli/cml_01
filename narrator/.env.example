# Copy this file to .env and fill in the two required values.
# Azure portal -> your Speech resource -> "Keys and Endpoint".

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=uksouth

# ---------------------------------------------------------------------------
# Everything below is optional.
# ---------------------------------------------------------------------------

PORT=5174

# Shown in the consent sentence the speaker has to read aloud.
VOICE_TALENT_COMPANY=Personal use

# Base model that carries a cloned voice. DragonLatestNeural is the most
# expressive; PhoenixLatestNeural is steadier and a little flatter.
AZURE_PERSONAL_VOICE_BASE_MODEL=DragonLatestNeural

# Personal Voice is a preview API; bump this if Microsoft moves the version.
AZURE_CUSTOMVOICE_API_VERSION=2024-02-01-preview

# Audio coming back from Azure. Must stay an mp3 format for the stream-copy
# concat to work without re-encoding.
AZURE_OUTPUT_FORMAT=audio-24khz-160kbitrate-mono-mp3

# Characters per synthesis request. Azure caps one request at 10 minutes of
# audio; 2400 characters is roughly 2.5 minutes, which leaves plenty of room.
MAX_CHUNK_CHARS=2400

# Parallel requests. 3 is comfortable on a standard S0 tier; raise it only if
# you are not seeing 429s.
SYNTH_CONCURRENCY=3

# Used only for the cost estimate shown before you press render.
USD_PER_MILLION_NEURAL=15
USD_PER_MILLION_PERSONAL=24
USD_TO_GBP=0.79
