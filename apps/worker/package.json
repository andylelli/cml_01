{
  "name": "@cml/worker",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./jobs/mystery-orchestrator.js": {
      "types": "./dist/jobs/mystery-orchestrator.d.ts",
      "default": "./dist/jobs/mystery-orchestrator.js"
    },
    "./jobs/cli-runtime.js": {
      "types": "./dist/jobs/cli-runtime.d.ts",
      "default": "./dist/jobs/cli-runtime.js"
    },
    "./jobs/save-readable-story.js": {
      "types": "./dist/jobs/save-readable-story.d.ts",
      "default": "./dist/jobs/save-readable-story.js"
    },
    "./process-guards.js": {
      "types": "./dist/process-guards.d.ts",
      "default": "./dist/process-guards.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node dist/index.js",
    "test": "vitest run",
    "harness:agent5:direct": "npm run build && node dist/harness/agent5-direct-llm-check-harness.js",
    "harness:agent5:direct:help": "npm run build && node dist/harness/agent5-direct-llm-check-harness.js --help"
  },
  "dependencies": {
    "dotenv": "*",
    "@cml/cml": "file:../../packages/cml",
    "@cml/llm-client": "file:../../packages/llm-client",
    "@cml/prompts-llm": "file:../../packages/prompts-llm",
    "@cml/story-validation": "file:../../packages/story-validation",
    "@cml/prose-guard": "file:../../packages/prose-guard",
    "@cml/beat-scheduler": "file:../../packages/beat-scheduler",
    "@cml/rubric-score": "file:../../packages/rubric-score",
    "@cml/clue-spec": "file:../../packages/clue-spec",
    "@cml/story-geometry": "file:../../packages/story-geometry",
    "@cml/novelty": "file:../../packages/novelty"
  },
  "devDependencies": {
    "vitest": "^2.1.5"
  }
}
