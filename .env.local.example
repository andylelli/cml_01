# Azure OpenAI Configuration
# Copy this file to .env.local and fill in your values

# Azure OpenAI API Configuration
AZURE_OPENAI_API_KEY=your_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-15-preview
AZURE_OPENAI_DEPLOYMENT_GPT4=gpt-4
AZURE_OPENAI_DEPLOYMENT_GPT35=gpt-35-turbo

# REQUIRED — the model the pipeline and every canary/probe actually resolve.
# Found 2026-08-24 (A_73): a config copied from this file cannot run a canary, because
# `canary-core.mjs` hard-requires this key and it was not listed here. It refuses rather
# than defaulting — X14: "a probe that silently measures the wrong model is worse than
# none" — so the failure is loud, but the example that is supposed to bootstrap a machine
# was missing the one variable that makes it runnable.
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1

# Logging Configuration
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_FILE_PATH=./logs/llm.jsonl
LOG_TO_CONSOLE=true

# Performance Configuration
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=3
LLM_RATE_LIMIT_PER_MINUTE=60

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=60000

# Caching Configuration
ENABLE_LLM_CACHE=true
CACHE_TTL_MS=3600000

# Cost Limits
MAX_COST_PER_REQUEST_USD=1.00
ALERT_COST_THRESHOLD_USD=0.50

# Monitoring Configuration
ENABLE_METRICS=true
METRICS_INTERVAL_MS=60000
ENABLE_ALERTS=true

# ─────────────────────────────────────────────────────────────────────────────
# BEHAVIOUR FLAGS  (A_73 §13.4)
#
# This file documented only infrastructure, so the configuration that produced
# the archived corpus was not reconstructable from the repository — by a new
# machine, a reinstall, or anyone reading the boards. The flags below are the
# ones the ANALYSIS/REVIEW series actually discusses. All are COMMENTED OUT:
# uncommenting changes behaviour, and the house rule is that behaviour levers
# ship flag-gated and are probed before promotion.
#
# `npm run flags:check` compares what the code reads, what this file sets, and
# what architecture/FLAG-AUDIT.md documents. Keep the three in step.
# ─────────────────────────────────────────────────────────────────────────────

# --- Novelty (the one engine that earns 9s — A_72 §2.1) ----------------------
# NOVELTY_CROSS_RUN defaults to "shadow", which is ENGAGED, not off. Only an
# explicit "off" disables the cross-run ledger.
# NOVELTY_CROSS_RUN=shadow
# NOVELTY_MODE=shadow
# NOVELTY_SIMILARITY_THRESHOLD=1.0   # 1.0 = the audit can never fail (A_72 §2.1)
# CML_NOVELTY_LEDGER_PATH=           # override the ledger location (A_73 §12.1)

# --- Agent 9 craft levers, all default OFF -----------------------------------
# AGENT9_PROMPT_BUDGET_CRAFT_FLOOR=true  # X47: stop the squeeze deleting craft_guide first
# AGENT9_RUBRIC_IN_PROMPT=true           # M6: the only lever aimed at the flat three
# AGENT9_CROSS_CHAPTER_ECHO=true         # A_72 C3 gate — see A_73 §6 before enabling
# AGENT9_OPENING_STYLE_PER_STORY=true    # X94 (falsified at n=1)
# AGENT9_SENSORY_PALETTE_ROTATION=true   # X95
# AGENT9_FOLD_SUSPECT_CLEARANCES=true    # X93
# AGENT9_POLISH_PROVIDER=anthropic       # full-story polish has NEVER run on any archived report
# AGENT9_POLISH_ANTHROPIC_MODEL=claude-sonnet-5
# ANTHROPIC_API_KEY=                     # required by the polish path

# --- Upstream gates, default OFF ---------------------------------------------
# AGENT3_DEVICE_TIME_BINDING=true
# AGENT5_RED_HERRING_FLOOR=true
# AGENT9_GEOMETRY_ACCEPTANCE=true

# --- Judge ---------------------------------------------------------------------
# Unset means the judge silently inherits AZURE_OPENAI_DEPLOYMENT_NAME, which
# means changing the base model retunes the scale that gates the pipeline (A_71 §7).
# RUBRIC_JUDGE_MODEL=
