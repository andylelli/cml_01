# Azure OpenAI Configuration
# Required for mystery generation pipeline

AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini

# Optional: API Version (defaults to 2024-10-21)
# AZURE_OPENAI_API_VERSION=2024-10-21

# ── Agent 9 post-pass polish provider (optional, default OFF) ────────────────────
# Routes ONLY the post-pass polish stage — which runs on chapters that have already
# passed every hard gate — to Anthropic. A failing chapter is never sent here.
# Unset ⇒ polish stays on the Azure deployment, byte-identical to previous behaviour.
# AGENT9_POLISH_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# Optional: model id (default claude-sonnet-5)
# AGENT9_POLISH_ANTHROPIC_MODEL=claude-sonnet-5
# Optional: alternate endpoint (e.g. Microsoft Foundry)
# ANTHROPIC_BASE_URL=
# Optional: re-enable adaptive thinking (default disabled — thinking shares the
# max_tokens budget with the reply and bills at the output rate)
# ANTHROPIC_THINKING=adaptive
