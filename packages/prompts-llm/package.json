{
  "name": "@cml/prompts-llm",
  "version": "1.0.0",
  "description": "LLM prompt templates for all 8 mystery generation agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent9-prose": {
      "types": "./dist/agent9-prose/index.d.ts",
      "default": "./dist/agent9-prose/index.js"
    },
    "./temporal-anchor": {
      "types": "./dist/shared/temporal-anchor.d.ts",
      "default": "./dist/shared/temporal-anchor.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cml/cml": "*",
    "@cml/clue-spec": "file:../clue-spec",
    "@cml/llm-client": "*",
    "@cml/period-kb": "*",
    "@cml/prose-guard": "*",
    "@cml/story-geometry": "*",
    "dotenv": "^17.2.4",
    "json-schema-to-ts": "3.1.1",
    "jsonrepair": "^3.13.2",
    "yaml": "^2.3.4",
    "@cml/story-validation": "*",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0",
    "@types/js-yaml": "^4.0.9",
    "@cml/rubric-score": "*"
  }
}
